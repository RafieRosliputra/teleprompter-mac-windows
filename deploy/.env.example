# Copy to /mnt/ssd/teleprompter/.env on TrueNAS
PUBLIC_URL=https://tele.johorstudio.com
# Long random string; paste the same value into the Mac app (Tetapan > Token admin)
ADMIN_TOKEN=change-me
# Self-hosted mail server (email-johorstudio), LAN submission port
SMTP_HOST=192.168.0.100
SMTP_PORT=1587
SMTP_USER=noreply@johorstudio.com
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_VERIFY=false
EMAIL_FROM=Johor Studio <noreply@johorstudio.com>
REPLY_TO=rafierosliputra@gmail.com
# Owner gets a copy of every new script
NOTIFY_EMAIL=rafierosliputra@gmail.com
